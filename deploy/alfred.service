# systemd unit for Alfred. Installed by deploy/install.sh; edit paths if you install by hand.
[Unit]
Description=Alfred personal assistant
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=alfred
Group=alfred
WorkingDirectory=/opt/alfred
EnvironmentFile=/opt/alfred/.env
Environment=HF_HOME=/opt/alfred/data/models/hf XDG_CACHE_HOME=/opt/alfred/data/cache
ExecStart=/opt/alfred/.venv/bin/uvicorn app.main:create_app --factory --host ${ALFRED_LISTEN} --port ${ALFRED_PORT} --proxy-headers
Restart=on-failure
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/alfred/data /opt/alfred/prompts

[Install]
WantedBy=multi-user.target
