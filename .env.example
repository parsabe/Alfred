# Alfred configuration. Copy to `.env` (git-ignored) and adjust.
# Everything runs on your own server: no API keys, no cloud services.
# The only required value is ALFRED_API_TOKEN. deploy/install.sh fills it in for you.

# ─── Access ──────────────────────────────────────────────────────────────────────────────
# REQUIRED. The password your devices use (sent as `Authorization: Bearer <token>`). 32+ chars.
# Generate one with:  make token
ALFRED_API_TOKEN=
# Where the service listens. 127.0.0.1 = this machine only (use Tailscale to reach it from your
# devices); 0.0.0.0 = the whole local network. Used by the systemd service.
ALFRED_LISTEN=127.0.0.1
ALFRED_PORT=8000
# Browser origins allowed to call the API from another site (the built-in app needs none).
CORS_ORIGINS=
# Optional. Only allow these networks, e.g. 100.64.0.0/10 (Tailscale), 192.168.0.0/16 (home).
IP_ALLOWLIST=

# ─── You ─────────────────────────────────────────────────────────────────────────────────
# Your own name (Alfred is his). Leave empty and he simply calls you "sir".
OWNER_NAME=
OWNER_ADDRESS_AS=sir
OWNER_PROFILE=Prefers to be addressed as "sir", in the manner of Alfred Pennyworth.
OWNER_TIMEZONE=Europe/Berlin
OWNER_LOCATION=Berlin, Germany

# ─── Alfred's mind: Gemma 3 12B via Ollama ───────────────────────────────────────────────
LLM_PROVIDER=local
LLM_MODEL=gemma3:12b
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# Must match Ollama's OLLAMA_CONTEXT_LENGTH (install.sh sets 8192).
LOCAL_LLM_CONTEXT_TOKENS=8192
# Seconds to wait for a whole answer. CPU-only servers are slow with a 12B model.
LLM_TIMEOUT_S=180
TURN_TIMEOUT_S=240

# ─── Alfred's ears: Whisper, on this server ──────────────────────────────────────────────
# whisper | none
STT_PROVIDER=whisper
# tiny | base | small | medium. "base" suits 12 GB RAM next to Gemma 12B; "small" hears
# better (needs ~0.5 GB more RAM and more CPU).
WHISPER_MODEL=base
# Language you speak, e.g. en or de. Empty = detect automatically each time.
SPEECH_LANGUAGE=

# ─── Alfred's voice: Piper, on this server ───────────────────────────────────────────────
# piper | none (none = devices use their own built-in voice)
TTS_PROVIDER=piper
# Any voice from https://rhasspy.github.io/piper-samples/ e.g. en_GB-alan-medium,
# en_GB-northern_english_male-medium, en_US-ryan-high
PIPER_VOICE=en_GB-alan-medium
# 1.0 = normal; 0.9 = a touch slower and more stately.
PIPER_SPEED=1.0
# Where downloaded speech models are kept.
MODELS_DIR=./data/models

# ─── Conversation ────────────────────────────────────────────────────────────────────────
# The name that wakes him.
WAKE_WORD=Alfred
# After answering, how long (seconds) he keeps listening for a follow-up without his name.
FOLLOW_UP_WINDOW_S=8
# Talking while he speaks interrupts him. BARGE_IN_MS: how long you must talk before his voice
# drops; BARGE_IN_HARD_MS: before he stops regardless of what you said.
BARGE_IN=true
BARGE_IN_MS=350
BARGE_IN_HARD_MS=1200
# Pause (ms) that marks the end of your sentence.
END_OF_SPEECH_MS=700
# 0-3: how strictly background noise is filtered out.
VAD_AGGRESSIVENESS=2

# ─── Storage and logs ────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/alfred.db
LOG_LEVEL=INFO
WEB_UI_ENABLED=true

# ─── Behaviour ───────────────────────────────────────────────────────────────────────────
# Token budget for each request (kept inside LOCAL_LLM_CONTEXT_TOKENS automatically).
CONTEXT_BUDGET_TOKENS=6000
RECENT_TURNS=12
MAX_AGENT_STEPS=8
DAILY_BRIEFING_TIME=07:30
QUIET_HOURS=22:00-07:00
FILES_SANDBOX_DIR=./data/files
