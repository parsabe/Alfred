# Alfred configuration. Copy to `.env` (git-ignored) and fill in.
# Only ALFRED_API_TOKEN and one LLM option are required. Every other key is optional:
# if it is empty, the feature it powers switches itself off and Alfred tells you so.

# ─── Core ────────────────────────────────────────────────────────────────────────────────
# REQUIRED. The token your interface sends as `Authorization: Bearer <token>`. 32+ chars.
# Generate one with:  make token
ALFRED_API_TOKEN=
# Optional. Your name, as Alfred should know it. Leave empty and he will simply say "sir".
OWNER_NAME=
# Optional. How Alfred addresses you ("sir", a first name, ...).
OWNER_ADDRESS_AS=sir
# Optional. Free-text standing facts about you, injected into Alfred's persona.
OWNER_PROFILE=Prefers to be addressed as "sir", in the manner of Alfred Pennyworth.
# Optional. IANA timezone for dates, reminders and the daily briefing.
OWNER_TIMEZONE=Europe/Berlin
# Optional. Used for weather and local context.
OWNER_LOCATION=Berlin, Germany
# Optional. SQLite by default; Postgres: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./data/alfred.db
# Optional. Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional. Comma-separated CIDRs allowed to connect (empty = any).
IP_ALLOWLIST=
# Optional. DEBUG | INFO | WARNING. LOG_JSON=true for one-line JSON logs.
LOG_LEVEL=INFO
LOG_JSON=false

# ─── LLM ─────────────────────────────────────────────────────────────────────────────────
# REQUIRED (one of these). anthropic | openai | local
#   anthropic → needs ANTHROPIC_API_KEY (default model claude-opus-5-5)
#   local     → any OpenAI-compatible server, e.g. Ollama running Gemma (no key needed)
#   openai    → needs OPENAI_API_KEY and LLM_MODEL
LLM_PROVIDER=anthropic
# Optional. Empty = provider default (anthropic: claude-opus-5-5, local: gemma3:12b).
#   Cheaper/faster Anthropic options: claude-sonnet-5-5, claude-haiku-5-5
LLM_MODEL=
# Optional. Used automatically if the primary is down/rate-limited, or not configured at all.
LLM_FALLBACK_PROVIDER=local
LLM_FALLBACK_MODEL=gemma3:12b
# Optional. Anthropic reasoning effort: low | medium | high | xhigh | max (empty = model default).
LLM_EFFORT=
# Optional. Max tokens per model response, and per-request timeout in seconds.
LLM_MAX_OUTPUT_TOKENS=16000
LLM_TIMEOUT_S=120
# Optional. Anthropic: on a safety refusal, let the API retry on a fallback model (recommended).
ANTHROPIC_REFUSAL_FALLBACK=true
# Optional (required if LLM_PROVIDER=anthropic). https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional (required if LLM_PROVIDER=openai).
OPENAI_API_KEY=
# Optional (required if LLM_PROVIDER=local). Ollama: http://localhost:11434/v1
#   Setup:  ollama pull gemma3:12b
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# Optional. Only if your local server requires a key (vLLM/LM Studio sometimes do).
LOCAL_LLM_API_KEY=
# Optional. JSON price overrides in USD per million tokens: {"model": [input, output, cache_read]}
LLM_PRICE_OVERRIDES=
# Optional (M3). Embeddings for semantic memory: openai | local | (empty = keyword search).
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=

# ─── Voice (Fish Audio) ──────────────────────────────────────────────────────────────────
# Optional. Enables Alfred's spoken voice. https://fish.audio → API keys
FISH_AUDIO_API_KEY=
# Optional. The voice model (reference) id for Alfred's voice.
FISH_AUDIO_VOICE_ID=098df6366d3845258e2b00ed4844c9cc
# Optional. Fish Audio TTS model.
FISH_AUDIO_MODEL=s2.1-pro-free

# ─── Integrations (all optional; feature auto-disables if empty) ────────────────────────
# tavily | brave | serpapi
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
# Optional. Weather works without a key (Open-Meteo); a key switches to OpenWeather.
WEATHER_API_KEY=
# Google Calendar (OAuth client from Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Home Assistant: base URL and a long-lived access token.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Telegram bot (not planned for now; left for completeness).
TELEGRAM_BOT_TOKEN=
# Optional. POSTed a JSON payload for every proactive message (reminders, briefings).
PUSH_WEBHOOK_URL=

# ─── Behaviour ───────────────────────────────────────────────────────────────────────────
# Comma-separated tool names that may run without confirmation (never applies to critical tools).
AUTO_APPROVE=
# Max model↔tool round-trips per turn, and the wall-clock limit for a whole turn (seconds).
MAX_AGENT_STEPS=8
TURN_TIMEOUT_S=120
# Token budget for the context sent to the model each turn, and max recent turns kept verbatim.
CONTEXT_BUDGET_TOKENS=60000
RECENT_TURNS=20
# Daily briefing time (local), and the window with no proactive messages (urgent reminders excepted).
DAILY_BRIEFING_TIME=07:30
QUIET_HOURS=22:00-07:00
# The only directory the files tool may read/write.
FILES_SANDBOX_DIR=./data/files
# Run model-written code in an isolated container. Off by default; needs Docker.
CODE_EXEC_ENABLED=false
